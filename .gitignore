# =============================================================================
# FDG Knowledge Repository
# Holds both governance knowledge (markdown) and code (Projects/).
# The notes and the code are the asset; tooling state is not.
# =============================================================================

# ---- Obsidian --------------------------------------------------------------
# Third-party plugin and theme bundles (~28 MB of vendored main.js) and
# per-machine UI state. Vault settings that define shared behaviour
# (app.json, appearance.json, core-plugins.json, community-plugins.json)
# stay tracked so the vault config is reproducible.
.obsidian/plugins/
.obsidian/themes/
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# ---- Secrets ---------------------------------------------------------------
# Defensive. Plugin and tool configs are where API keys tend to appear later
# even when none are present today.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
**/secrets.json
**/credentials.json
**/service-account*.json

# ---- Node / tooling --------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Test output -----------------------------------------------------------
# Screenshots are regenerated by verify/smoke-test.mjs on every run.
Projects/**/verify/screenshots/
playwright-report/
test-results/

# ---- Build output ----------------------------------------------------------
dist/
build/
.cache/

# ---- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
